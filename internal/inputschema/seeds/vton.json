{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vton",
  "description": "试衣：images[0] 是人物图，images[1] 是服装图",
  "x-category": "image_generation",
  "type": "object",
  "properties": {
    "images": {
      "type": "array",
      "description": "试衣：images[0] 是人物图，images[1] 是服装图",
      "items": {
        "type": "object",
        "required": [
          "mime_type",
          "data"
        ],
        "properties": {
          "mime_type": {
            "type": "string",
            "description": "图片 MIME",
            "pattern": "^image/[A-Za-z0-9.+-]+$"
          },
          "data": {
            "type": "string",
            "description": "图片原始字节的 Base64，不含 data URL 前缀",
            "minLength": 1,
            "contentEncoding": "base64"
          }
        },
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "prompt": {
      "type": "string",
      "description": "试衣提示词",
      "maxLength": 20000,
      "pattern": "[^\\t\\n\\v\\f\\r \\x1c-\\x1f\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]",
      "not": {
        "pattern": "\\x00"
      }
    }
  },
  "required": [
    "images",
    "prompt"
  ],
  "additionalProperties": false,
  "x-experimental-properties": {
    "use_pe": {
      "type": "string",
      "description": "仅实验凭据可覆盖的生成参数",
      "pattern": "^([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])$"
    }
  }
}
